        <script><![CDATA[(function triggerInvestigation(current, previous) {
    try {
        var incidentSysId = current.getUniqueValue();
        gs.info('AI Investigation: Triggering investigation for incident ' + incidentSysId);

        var investigator = new global.InvestigationService(incidentSysId);
        var reportSysId = investigator.generateReport();

        if (reportSysId) {
            gs.info('AI Investigation: Report generated successfully - ' + reportSysId);
        } else {
            gs.error('AI Investigation: Failed to generate report for incident ' + incidentSysId);
        }
    } catch (e) {
        gs.error('AI Investigation: Error during investigation - ' + e);
    }
})(current, previous);
]]></script>
